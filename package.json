{
    "name": "outpost-monorepo",
    "version": "0.0.0",
    "private": true,
    "description": "Embeddable, correctness-first durable execution for Node/TypeScript: memoized steps, ambiguous-failure probes, durable sleep and cron, all inside your app on a pluggable storage backend.",
    "workspaces": [
        "packages/*",
        "examples/*"
    ],
    "scripts": {
        "build": "yarn workspaces run build",
        "test": "yarn workspaces run test",
        "typecheck": "yarn workspaces run typecheck",
        "clean": "yarn workspaces run clean",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "engines": {
        "node": ">=20"
    },
    "devDependencies": {
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/node": "^22",
        "prettier": "^3.9.6",
        "prettier-plugin-jsdoc": "^1.8.1",
        "typescript": "^5.6.3",
        "vitest": "^2.1.8"
    }
}
